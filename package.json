{
  "name": "bookcreator-layout-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "layout-inspector": "node cli/layout-inspector.mjs",
    "test:browser": "node tests/browser-measurement.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
